# TradeNews frontend environment (Cloudflare).
# Production site: https://tradenews.live
# Production API:  https://api.tradenews.live (or same-origin /api via Worker proxy)

# Backend API base URL. Leave empty to use same-origin /api.
VITE_TRADENEWS_API_BASE="https://api.tradenews.live"

# Cloudflare Turnstile site key (frontend). Secret stays on the backend Worker.
VITE_TURNSTILE_SITE_KEY=""

# FINANCIAL SAFETY: keep false. Real-money deposits/withdrawals/live trading
# stay disabled in the UI unless the owner explicitly enables this.
VITE_FINANCIAL_OPERATIONS_ENABLED="false"
